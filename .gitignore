# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated from src/data/quran by scripts/build-quran-notes.mjs
/public/quran/notes/

# generated by scripts/build-search-index.mjs (runs before build)
/public/search/

# download cache for data import scripts
/.cache/

# 80 MB of hadith data, generated by scripts/import-hadith.mjs (runs before build)
/src/data/hadith/

# hadith search index, generated by scripts/build-hadith-search-index.mjs (runs before build)
/src/data/hadith-search/
