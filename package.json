{
  "name": "improve-your-akhirah",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3077",
    "prebuild": "node scripts/build-quran-notes.mjs && node scripts/build-search-index.mjs && node scripts/import-hadith.mjs --if-missing && node scripts/build-hadith-search-index.mjs",
    "build": "next build ",
    "start": "next start --port 3077",
    "lint": "eslint",
    "data:quran": "node scripts/import-quran.mjs",
    "data:hadith": "node scripts/import-hadith.mjs",
    "data:quran-search": "node scripts/import-quran-search-text.mjs",
    "data:cities": "node scripts/import-cities.mjs",
    "data:search": "node scripts/build-search-index.mjs && node scripts/build-hadith-search-index.mjs"
  },
  "dependencies": {
    "adhan": "4.4.6",
    "leaflet": "1.9.4",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/leaflet": "1.9.23",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
